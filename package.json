{
  "name": "@apty/browser-agent",
  "displayName": "Apty Agent",
  "version": "0.1.0",
  "private": true,
  "description": "Apty's AI browser agent - forked from AIPex, customized for Apty Studio/widget integration",
  "author": "Apty",
  "scripts": {
    "postinstall": "prek install",
    "build": "pnpm -r --if-present build && npm run build:mcp-bridge && npm run check:tailwind-sources",
    "dev": "pnpm --filter @apty/browser-extension dev",
    "preflight": "npm run format && npm run lint:fix && npm run typecheck && npm run test",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix --unsafe",
    "lint:dependencies": "knip --strict",
    "test": "pnpm -r --if-present test && npm run test:mcp-bridge",
    "typecheck": "pnpm -r --if-present typecheck && npm run typecheck:mcp-bridge",
    "test:mcp-bridge": "npm --prefix apps/mcp-bridge test",
    "typecheck:mcp-bridge": "npm --prefix apps/mcp-bridge run typecheck",
    "build:mcp-bridge": "npm --prefix apps/mcp-bridge run build",
    "audit:branding": "node tooling/scripts/check-branding.mjs",
    "audit:architecture": "node tooling/scripts/check-architecture.mjs",
    "audit:tools": "node tooling/scripts/audit-tools.mjs",
    "validate:extension": "node tooling/scripts/validate-manifest.mjs",
    "check:tailwind-sources": "node tooling/scripts/check-tailwind-sources.mjs",
    "check:mcp-bridge-docs": "node tooling/scripts/check-mcp-bridge-docs.mjs",
    "generate:extension-key": "node tooling/scripts/generate-extension-key.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@j178/prek": "^0.3.1",
    "@types/chrome": "0.1.38",
    "@types/node": "^26.6.3",
    "knip": "^5.82.1",
    "playwright-core": "^1.63.0",
    "tinyglobby": "^0.2.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
