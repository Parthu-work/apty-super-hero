{
  "name": "@apty/debug-contract",
  "version": "0.1.0",
  "description": "Wire contract (schemas, redaction, safe serialization) shared between the Apty Agent extension and any Apty product extension (Client/Studio) that wants to expose service-worker logs to it",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parthu-work/apty-super-hero.git"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "!dist/src/**/*.test.js",
    "!dist/src/**/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json",
    "gen:contract-schemas": "tsx scripts/gen-schemas.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "apty",
    "contract",
    "redaction",
    "logging"
  ],
  "author": "Apty",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.21.0"
  }
}
