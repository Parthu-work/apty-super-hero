{
  "manifest_version": 3,
  "name": "Apty Agent",
  "version": "0.1.0",
  "description": "Apty's AI browser agent - understands the page, resolves elements, and drives Apty workflows",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/entrypoints/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/entrypoints/content/index.tsx"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/entrypoints/content/console-bridge.ts"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "side_panel": {
    "default_path": "src/entrypoints/sidepanel/index.html"
  },
  "options_ui": {
    "page": "src/entrypoints/options/index.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "externally_connectable": {
    "ids": []
  },
  "host_permissions": ["https://*/*", "http://*/*", "<all_urls>"],
  "commands": {
    "open-apty-agent": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "Command+M"
      },
      "description": "Open command menu"
    }
  },
  "permissions": [
    "tabs",
    "windows",
    "tabGroups",
    "activeTab",
    "bookmarks",
    "browsingData",
    "history",
    "scripting",
    "commands",
    "storage",
    "contextMenus",
    "sessions",
    "sidePanel",
    "management",
    "downloads",
    "debugger",
    "webNavigation",
    "alarms",
    "clipboardWrite"
  ],
  "key": ""
}
