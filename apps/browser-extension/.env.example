# Copy this file to .env and fill in real values. Never commit .env itself —
# it's gitignored. Every value below is a placeholder; leaving a value empty
# means that integration is not configured and the corresponding diagnostics
# tool will report status: "not_configured" rather than fail or fabricate data.

# --- BYOK AI provider (optional at build time; also configurable at runtime
# in the extension's Options page) ---
# VITE_AI_HOST=
# VITE_AI_TOKEN=
# VITE_AI_MODEL=

# --- Apty Studio integration ---
# The Chrome extension ID of Apty Studio, if Studio ships as a separate
# extension and has agreed to accept messages from this extension (i.e. it
# lists this extension's ID in its own manifest's externally_connectable).
# Requires Studio to implement a corresponding message handler — see
# packages/browser-runtime/src/apty/studio-diagnostics.ts for the exact
# message contract this extension sends.
VITE_APTY_STUDIO_EXTENSION_ID=

# --- Apty Widget integration ---
# The Widget is assumed to run as page-injected JS (not a separate
# extension), so there is no extension ID to configure here — see
# packages/browser-runtime/src/apty/widget-diagnostics.ts for the
# window.__APTY_WIDGET__ contract the Widget needs to implement instead.
VITE_APTY_WIDGET_EXTENSION_ID=

# --- Apty Client integration ---
# Same situation as the Widget — see client-diagnostics.ts for the
# window.__APTY_CLIENT__ contract.
VITE_APTY_CLIENT_EXTENSION_ID=

# --- Apty Service Worker diagnostics ---
# Configure AT MOST ONE of the two below. Chrome does not allow one
# extension to read another's private service-worker memory directly, so
# one of these Apty-side channels is required:
#   1. An extension ID that implements the message contract in
#      packages/browser-runtime/src/apty/service-worker-diagnostics.ts —
#      see docs/apty-integration/apty-widget-service-worker.reference.ts
#      for a complete, ready-to-adapt implementation of that side, or
#   2. An HTTP diagnostic endpoint (GET <endpoint>/status, GET <endpoint>/logs)
VITE_APTY_SERVICE_WORKER_EXTENSION_ID=
VITE_APTY_SERVICE_WORKER_DIAGNOSTIC_ENDPOINT=
