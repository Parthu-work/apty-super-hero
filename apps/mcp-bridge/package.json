{
  "name": "apty-mcp-bridge",
  "version": "3.1.0",
  "private": true,
  "description": "MCP bridge that connects AI agents (Cursor, Claude Code, VS Code Copilot, etc.) to the Apty Agent browser extension. Auto-spawns a shared daemon to support multiple simultaneous clients. Not published — run it locally (see README.md).",
  "type": "module",
  "bin": {
    "apty-mcp-bridge": "./dist/bridge.js",
    "apty-mcp-daemon": "./dist/daemon.js",
    "apty-cli": "./dist/cli.js",
    "browser-cli": "./dist/browser-cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/bridge.ts",
    "dev:daemon": "tsx src/daemon.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "apty",
    "browser",
    "cursor",
    "claude",
    "copilot",
    "websocket",
    "bridge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Parthu-work/apty-super-hero.git",
    "directory": "apps/mcp-bridge"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": ">=2.0.8",
      "minimatch@>=10.0.0 <10.2.3": ">=10.2.3",
      "path-to-regexp@>=8.0.0 <8.4.0": ">=8.4.0",
      "hono": ">=4.13.7",
      "@hono/node-server": ">=1.19.15",
      "fast-uri": ">=3.1.8",
      "ip-address": ">=10.7.1",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0",
      "body-parser": ">=2.3.0"
    }
  }
}
