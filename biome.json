{
  "root": true,
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useSemanticElements": "off"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.json"],
      "formatter": {
        "indentStyle": "space",
        "indentWidth": 2
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tooling/**",
        "packages/*/scripts/**",
        "packages/agent-core/examples/**",
        "packages/browser-runtime/src/skills/built-in/**/scripts/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/__tests__/**",
        "apps/browser-extension/src/entrypoints/content/console-bridge.ts",
        "packages/agent-core/src/utils/logger.ts",
        "docs/integrations/apty/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/build",
      "!**/assets",
      "!**/bundled-modules",
      "!**/__tests__/fixtures/**/*.html",
      "!**/.vscode",
      "!.history"
    ]
  }
}
