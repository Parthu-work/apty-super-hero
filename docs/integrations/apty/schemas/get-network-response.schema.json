{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "requestId": {
            "type": "string"
          },
          "ts": {
            "type": "number"
          },
          "method": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "mimeType": {
            "type": "string"
          },
          "failed": {
            "type": "boolean"
          },
          "errorText": {
            "type": "string"
          },
          "durationMs": {
            "type": "number"
          },
          "context": {
            "type": "string",
            "enum": ["service-worker", "content-script", "popup"]
          }
        },
        "required": ["seq", "requestId", "ts", "method", "url", "context"],
        "additionalProperties": false
      }
    },
    "nextSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "oldestSeq": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "dropped": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": ["entries", "nextSeq", "oldestSeq", "dropped", "truncated"],
  "additionalProperties": false
}
