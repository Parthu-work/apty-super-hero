{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "type": {
      "type": "string",
      "pattern": "^apty-debug-agent:.*"
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "v",
    "type",
    "requestId"
  ],
  "additionalProperties": false
}
