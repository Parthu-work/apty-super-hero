{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sinceSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 500
    },
    "minLevel": {
      "type": "string",
      "enum": [
        "trace",
        "debug",
        "log",
        "info",
        "warn",
        "error"
      ]
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "service-worker",
          "content-script",
          "popup"
        ]
      }
    }
  },
  "additionalProperties": false
}
